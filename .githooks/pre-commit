#!/usr/bin/env bash
set -euo pipefail

EXPECTED_EMAIL='ankitluthra111@gmail.com'
author_email="$(git var GIT_AUTHOR_IDENT | sed -n 's/.*<\([^>]*\)>.*/\1/p')"
committer_email="$(git var GIT_COMMITTER_IDENT | sed -n 's/.*<\([^>]*\)>.*/\1/p')"

if [[ "$author_email" != "$EXPECTED_EMAIL" || "$committer_email" != "$EXPECTED_EMAIL" ]]; then
  echo "Commit blocked: Colleague AI commits must use $EXPECTED_EMAIL." >&2
  echo "Configured author: $author_email; committer: $committer_email" >&2
  echo "Run: git config user.email '$EXPECTED_EMAIL'" >&2
  exit 1
fi
