{
  "openapi": "3.1.0",
  "info": {
    "title": "Colleague AI calls API",
    "version": "0.1.0",
    "description": "Start phone calls and meetings from a brief and read structured results. See docs/calls.md.",
    "license": { "name": "Apache-2.0", "identifier": "Apache-2.0" }
  },
  "servers": [{ "url": "http://127.0.0.1:8765" }],
  "security": [{ "bearer": [] }],
  "paths": {
    "/v1/calls/check": {
      "post": {
        "summary": "Validate a brief without starting a call",
        "operationId": "checkCall",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Brief" } } } },
        "responses": {
          "200": { "description": "Validation result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CheckResult" } } } },
          "422": { "$ref": "#/components/responses/BriefProblem" }
        }
      }
    },
    "/v1/calls": {
      "post": {
        "summary": "Start a call",
        "operationId": "startCall",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Brief" } } } },
        "responses": {
          "201": { "description": "Call accepted", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Call" } } } },
          "403": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/BriefProblem" },
          "503": { "$ref": "#/components/responses/Error" }
        }
      },
      "get": {
        "summary": "List recent calls, newest first",
        "operationId": "listCalls",
        "parameters": [
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } },
          { "name": "tzOffset", "in": "query", "description": "The reader's minutes east of UTC; spend is grouped by their local day.", "schema": { "type": "integer", "minimum": -840, "maximum": 840, "default": 0 } }
        ],
        "responses": {
          "200": { "description": "Calls", "content": { "application/json": { "schema": { "type": "object", "properties": { "calls": { "type": "array", "items": { "$ref": "#/components/schemas/Call" } }, "spend": { "$ref": "#/components/schemas/Spend" } }, "required": ["calls", "spend"] } } } }
        }
      }
    },
    "/v1/calls/{callId}": {
      "parameters": [{ "$ref": "#/components/parameters/CallId" }],
      "get": {
        "summary": "Get a call",
        "operationId": "getCall",
        "responses": {
          "200": { "description": "The call", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Call" } } } },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/calls/{callId}/wait": {
      "parameters": [{ "$ref": "#/components/parameters/CallId" }],
      "get": {
        "summary": "Wait until the call finishes or the timeout passes",
        "operationId": "waitForCall",
        "parameters": [{ "name": "timeout", "in": "query", "schema": { "type": "number", "minimum": 0, "maximum": 300, "default": 60 } }],
        "responses": {
          "200": { "description": "The call, terminal or not", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Call" } } } },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/calls/{callId}/events": {
      "parameters": [{ "$ref": "#/components/parameters/CallId" }],
      "get": {
        "summary": "Stream call events (server-sent events, resumable with Last-Event-ID)",
        "operationId": "streamCallEvents",
        "responses": { "200": { "description": "text/event-stream of call events", "content": { "text/event-stream": { "schema": { "type": "string" } } } } }
      }
    },
    "/v1/calls/{callId}/instructions": {
      "parameters": [{ "$ref": "#/components/parameters/CallId" }],
      "post": {
        "summary": "Add guidance to a call in progress",
        "operationId": "instructCall",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "properties": { "text": { "type": "string", "maxLength": 2000 }, "silent": { "type": "boolean", "default": false, "description": "A background note the voice uses when relevant, instead of guidance it acts on at once." } }, "required": ["text"], "additionalProperties": false } } } },
        "responses": {
          "200": { "description": "Whether the line accepted the guidance", "content": { "application/json": { "schema": { "type": "object", "properties": { "delivered": { "type": "boolean" } }, "required": ["delivered"] } } } },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/calls/{callId}/end": {
      "parameters": [{ "$ref": "#/components/parameters/CallId" }],
      "post": {
        "summary": "End the call politely and build the result",
        "operationId": "endCall",
        "responses": { "200": { "description": "The call", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Call" } } } } }
      }
    },
    "/v1/calls/{callId}/transfer": {
      "parameters": [{ "$ref": "#/components/parameters/CallId" }],
      "post": {
        "summary": "Hand a connected phone call to the owner's phone",
        "operationId": "transferCall",
        "responses": {
          "200": { "description": "Transfer started", "content": { "application/json": { "schema": { "type": "object" } } } },
          "409": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/v1/voices": {
      "get": {
        "summary": "List GPT-Live voices",
        "operationId": "listVoices",
        "responses": { "200": { "description": "Voices", "content": { "application/json": { "schema": { "type": "object", "properties": { "default": { "type": "string" }, "voices": { "type": "array", "items": { "type": "string" } } }, "required": ["default", "voices"] } } } } }
      }
    },
    "/v1/profile": {
      "get": {
        "summary": "Get the owner's profile, which every phone call gets as background",
        "operationId": "getProfile",
        "responses": {
          "200": { "description": "The profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Profile" } } } },
          "501": { "$ref": "#/components/responses/Error" }
        }
      },
      "patch": {
        "summary": "Update the owner's profile",
        "operationId": "updateProfile",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProfileUpdate" } } } },
        "responses": {
          "200": { "description": "The saved profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Profile" } } } },
          "422": { "$ref": "#/components/responses/Error" },
          "501": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer", "description": "The per-launch token in .colleague/daemon.auth, or an API token in server mode." }
    },
    "parameters": {
      "CallId": { "name": "callId", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^call-[0-9a-f]{16}$" } }
    },
    "responses": {
      "Error": { "description": "Error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "BriefProblem": { "description": "The brief is invalid or incomplete", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "schemas": {
      "Brief": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel", "to", "objective", "onBehalfOf"],
        "properties": {
          "channel": { "type": "string", "enum": ["phone", "meeting"] },
          "to": { "type": "string", "description": "E.164 phone number for phone calls, or a Zoom, Teams, or Google Meet invite URL." },
          "onBehalfOf": { "type": "string", "maxLength": 120, "description": "Name spoken in the AI disclosure at the start of the call." },
          "objective": { "type": "string", "maxLength": 1000 },
          "context": {
            "description": "What the calling agent and the owner have been working on. The voice starts with a short version and the backend model gets it all. See docs/calls.md#context.",
            "oneOf": [{ "type": "string", "maxLength": 6000 }, { "$ref": "#/components/schemas/SessionContext" }]
          },
          "questions": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 20, "description": "What to find out. The result's details answer each one." },
          "tone": { "type": "string", "maxLength": 200, "description": "How to come across. Defaults to matching the relationship." },
          "contact": { "$ref": "#/components/schemas/Contact" },
          "mayAgreeTo": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 20 },
          "mustNotShare": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 20 },
          "successCriteria": { "type": "string", "maxLength": 500 },
          "language": { "type": "string", "examples": ["en", "pt-BR"] },
          "voice": { "type": "string", "examples": ["marin"] },
          "maxMinutes": { "type": "integer", "minimum": 1, "maximum": 240, "description": "Phone calls: at most 60 (default 10). Meetings: at most 240 (default 120)." },
          "rehearsal": { "type": "boolean", "description": "Phone only: practice the call on the owner's own phone." },
          "notify": { "type": "object", "additionalProperties": false, "properties": { "webhookUrl": { "type": "string", "format": "uri" } } }
        }
      },
      "SessionContext": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "summary": { "type": "string", "maxLength": 4000, "description": "A few sentences the voice starts with." },
          "facts": { "type": "array", "items": { "type": "string", "maxLength": 400 }, "maxItems": 40 },
          "decisions": { "type": "array", "items": { "type": "string", "maxLength": 400 }, "maxItems": 20 },
          "openQuestions": { "type": "array", "items": { "type": "string", "maxLength": 400 }, "maxItems": 20 },
          "details": { "type": "string", "maxLength": 24000, "description": "Long reference material, given only to the backend model the voice consults." }
        }
      },
      "Contact": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "description": "Who is being called, when the profile does not know the number.",
        "properties": {
          "name": { "type": "string", "maxLength": 80 },
          "relationship": { "type": "string", "maxLength": 120 },
          "notes": { "type": "string", "maxLength": 600 }
        }
      },
      "Person": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "maxLength": 80 },
          "relationship": { "type": "string", "maxLength": 120 },
          "phone": { "type": "string", "description": "E.164, such as +14155550142. Spaces, dots, dashes, and parentheses are removed." },
          "notes": { "type": "string", "maxLength": 600 }
        }
      },
      "Profile": {
        "type": "object",
        "required": ["version"],
        "properties": {
          "version": { "type": "integer" },
          "about": { "type": "string", "maxLength": 2000 },
          "style": { "type": "string", "maxLength": 600 },
          "boundaries": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 20 },
          "people": { "type": "array", "items": { "$ref": "#/components/schemas/Person" }, "maxItems": 100 }
        }
      },
      "ProfileUpdate": {
        "type": "object",
        "additionalProperties": false,
        "description": "Fields present replace the saved ones; people are added or updated by name (ignoring case); removePeople drops names.",
        "properties": {
          "about": { "type": "string", "maxLength": 2000 },
          "style": { "type": "string", "maxLength": 600 },
          "boundaries": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 20 },
          "people": { "type": "array", "items": { "$ref": "#/components/schemas/Person" }, "maxItems": 100 },
          "removePeople": { "type": "array", "items": { "type": "string" } }
        }
      },
      "CheckResult": {
        "type": "object",
        "required": ["ok", "brief", "problems"],
        "properties": {
          "ok": { "type": "boolean" },
          "brief": { "$ref": "#/components/schemas/Brief" },
          "problems": { "type": "array", "items": { "type": "string" } }
        }
      },
      "Call": {
        "type": "object",
        "required": ["id", "channel", "status", "brief", "createdAt"],
        "properties": {
          "id": { "type": "string" },
          "owner": { "type": "string" },
          "channel": { "type": "string", "enum": ["phone", "meeting"] },
          "status": { "type": "string", "enum": ["queued", "connecting", "ringing", "waiting", "in_progress", "summarizing", "completed", "failed", "canceled"] },
          "endReason": { "type": "string", "enum": ["hangup", "remote_hangup", "no_answer", "busy", "voicemail", "max_duration", "canceled", "meeting_ended", "transferred", "error"] },
          "brief": { "$ref": "#/components/schemas/Brief" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" },
          "answeredAt": { "type": "string", "format": "date-time" },
          "endedAt": { "type": "string", "format": "date-time" },
          "line": { "type": "object", "description": "Line references such as meetingId." },
          "result": { "oneOf": [{ "$ref": "#/components/schemas/Result" }, { "type": "null" }] },
          "direction": { "type": "string", "enum": ["outbound", "inbound"] },
          "recording": { "type": "object", "description": "Phone calls recorded with COLLEAGUE_RECORD_CALLS=1. The url is a Twilio API URL; fetching it needs the Twilio account SID and auth token.", "properties": { "sid": { "type": "string" }, "url": { "type": "string" }, "seconds": { "type": "integer" } } },
          "usage": { "type": "object", "description": "Measured usage: voiceSeconds, phoneSeconds, phoneProvider, phonePrice (the provider's own price, once reported), backendTokens and backendModel, summaryTokens and summaryModel." },
          "cost": { "$ref": "#/components/schemas/Cost" },
          "error": { "type": "string" }
        }
      },
      "Cost": {
        "type": "object",
        "description": "Finished calls only. Phone: what the provider billed, or an estimate until it reports. OpenAI: calculated from usage at list prices as of pricesAsOf.",
        "required": ["currency", "total", "phone", "openai", "estimated", "items", "pricesAsOf"],
        "properties": {
          "currency": { "type": "string", "enum": ["USD"] },
          "total": { "type": "number" },
          "phone": { "type": "number" },
          "openai": { "type": "number" },
          "estimated": { "type": "boolean", "description": "True while the phone line is estimated." },
          "unpriced": { "type": "array", "items": { "type": "string" }, "description": "Models with no known price; left out of the total." },
          "pricesAsOf": { "type": "string", "format": "date" },
          "items": { "type": "array", "items": { "type": "object", "required": ["kind", "amount", "source"], "properties": {
            "kind": { "type": "string", "enum": ["phone", "voice", "backend", "summary"] },
            "amount": { "type": ["number", "null"] },
            "source": { "type": "string", "enum": ["provider", "list_price", "estimate"] },
            "provider": { "type": ["string", "null"] },
            "model": { "type": "string" },
            "seconds": { "type": ["integer", "null"] },
            "ratePerMinute": { "type": "number" },
            "input": { "type": "integer" },
            "cached": { "type": "integer" },
            "output": { "type": "integer" },
            "webSearches": { "type": "integer" }
          } } }
        }
      },
      "Spend": {
        "type": "object",
        "required": ["currency", "pricesAsOf", "days"],
        "properties": {
          "currency": { "type": "string", "enum": ["USD"] },
          "pricesAsOf": { "type": "string", "format": "date" },
          "days": { "type": "array", "description": "Finished calls per local day, oldest first.", "items": { "type": "object", "properties": {
            "day": { "type": "string", "format": "date" },
            "calls": { "type": "integer" },
            "total": { "type": "number" },
            "phone": { "type": "number" },
            "openai": { "type": "number" },
            "estimated": { "type": "boolean" }
          } } }
        }
      },
      "Result": {
        "type": "object",
        "required": ["outcome", "summary", "details", "decisions", "actionItems", "openQuestions", "transcript", "durationSeconds"],
        "properties": {
          "outcome": { "type": "string", "enum": ["achieved", "partial", "not_reached", "voicemail", "declined", "failed", "canceled"] },
          "summary": { "type": "string" },
          "details": { "type": "array", "items": { "type": "object", "required": ["label", "value"], "properties": { "label": { "type": "string" }, "value": { "type": "string" } } } },
          "decisions": { "type": "array", "items": { "type": "string" } },
          "actionItems": { "type": "array", "items": { "type": "string" } },
          "openQuestions": { "type": "array", "items": { "type": "string" } },
          "transcript": { "type": "array", "items": { "type": "object", "required": ["speaker", "text"], "properties": { "speaker": { "type": "string" }, "text": { "type": "string" } } } },
          "durationSeconds": { "type": "integer" },
          "source": { "type": "string", "enum": ["summary_model", "meeting_handoff", "status", "fallback"] },
          "disclosureVerified": { "type": ["boolean", "null"], "description": "Outbound phone calls only. True when the opening was heard saying it is an AI calling for onBehalfOf; false when it was not, even after a reminder; null when the agent never spoke." }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "missing": { "type": "array", "items": { "type": "object", "properties": { "field": { "type": "string" }, "question": { "type": "string" } } } }
            }
          }
        }
      }
    }
  }
}
