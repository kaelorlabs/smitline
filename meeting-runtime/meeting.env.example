MEETING_URL=https://us05web.zoom.us/j/YOUR_MEETING_ID
# Teams: https://teams.microsoft.com/l/meetup-join/YOUR_MEETING_ID
# Meet:  https://meet.google.com/aaa-bbbb-ccc
MEETING_PASSCODE=your_meeting_passcode

SMITLINE_PARTICIPANT_NAME=Smitline
# Camera is a join-time setting, not an env flag.
# Hard questions go to this backend model (Responses delegation); 1 lets it search the web.
SMITLINE_MEETING_BACKEND_MODEL=gpt-5.6-terra
SMITLINE_MEETING_WEB_SEARCH=0
# Optional plain-text context or role guidance for this meeting (max 2,000 characters).
SMITLINE_MEETING_INSTRUCTIONS=
