OPENAI_API_KEY=replace_with_your_project_api_key

# Easiest: run `colleague setup secrets` and fill in the page instead of editing this file.

# Your name, spoken in the AI disclosure ("calling on behalf of ..."), and your phone
# for rehearsals, the setup test call, and taking over calls.
# COLLEAGUE_OWNER_NAME=Your Name
# COLLEAGUE_OWNER_PHONE=+14155550100
# GPT-Live voice for meetings and calls (see `colleague voices`), and extra voice names to allow.
# COLLEAGUE_VOICE=marin
# COLLEAGUE_EXTRA_VOICES=
# Meetings open with a short AI disclosure naming COLLEAGUE_OWNER_NAME unless a call
# brief names someone else. Set to 0 to turn it off.
# COLLEAGUE_MEETING_INTRO=1
# The model GPT-Live hands hard questions to, and whether it may search the web (1 to allow).
# COLLEAGUE_PHONE_BACKEND_MODEL=gpt-5.6-terra
# COLLEAGUE_PHONE_WEB_SEARCH=0
# COLLEAGUE_MEETING_BACKEND_MODEL=gpt-5.6-terra
# COLLEAGUE_MEETING_WEB_SEARCH=0

# Phone calls (optional). See docs/phone.md. The numbers below are examples.
# SignalWire's free trial works (calls to up to 10 verified numbers); Twilio needs an upgraded account.
# SIGNALWIRE_SPACE=yourname.signalwire.com
# SIGNALWIRE_PROJECT_ID=replace_with_your_project_id
# SIGNALWIRE_API_TOKEN=replace_with_your_api_token
# SIGNALWIRE_SIGNING_KEY=replace_with_your_signing_key
# SIGNALWIRE_FROM_NUMBER=+14155550124
# TWILIO_ACCOUNT_SID=replace_with_your_twilio_account_sid
# TWILIO_AUTH_TOKEN=replace_with_your_twilio_auth_token
# A number bought in Twilio (needed for incoming calls).
# TWILIO_FROM_NUMBER=+14155550123
# Show your own verified number on outgoing calls instead.
# COLLEAGUE_CALLER_ID=+14155550100
# How call audio travels: relay (through this computer), sip (OpenAI dials out through a SIP
# trunk; `colleague setup sip-trunk` creates one on SignalWire), or sip-webhook. See docs/phone.md.
# COLLEAGUE_PHONE_AUDIO=relay
# COLLEAGUE_SIP_TRUNK_URL=sips:yourname-colleague-ai-openai.dapp.signalwire.com:5061
# COLLEAGUE_SIP_USERNAME=+14155550124
# COLLEAGUE_SIP_PASSWORD=replace_with_the_generated_password
# OPENAI_PROJECT_ID=proj_replace_me
# OPENAI_WEBHOOK_SECRET=replace_with_whsec_secret
# Record calls in your Twilio account (the agent says so on the call).
# COLLEAGUE_RECORD_CALLS=0
# SignalWire only: let its player smooth packet delays and bursts (Stream realtime).
# COLLEAGUE_STREAM_REALTIME=0
# Public HTTPS origin for Twilio when you run a server; laptops use a Cloudflare quick tunnel.
# COLLEAGUE_PUBLIC_URL=https://calls.example.com
# Answer calls to your Twilio number and send the message to a webhook.
# COLLEAGUE_ACCEPT_INBOUND=1
# COLLEAGUE_MAX_INBOUND=2
# COLLEAGUE_NOTIFY_WEBHOOK=https://example.com/hooks/colleague
# Allow result webhooks to hosts on your own network.
# COLLEAGUE_WEBHOOK_ALLOW_PRIVATE=0
# Restrict destinations by country calling code, for example 1,44.
# COLLEAGUE_ALLOWED_CALLING_CODES=1
# Write a timing trace of each phone call's audio (audio-trace.jsonl next to the call record), for diagnosing choppy sound.
# COLLEAGUE_AUDIO_TRACE=0
