OPENAI_API_KEY=replace_with_your_project_api_key
# Optional standalone voice diagnostic port (default: 8093)
PORT=8093

# Local search_web function for the meeting agent
TAVILY_API_KEY=replace_with_your_tavily_api_key

# Meetings open with a short AI disclosure naming COLLEAGUE_OWNER_NAME (below)
# unless a call brief names someone else. Set to 0 to turn it off.
# COLLEAGUE_MEETING_INTRO=1
# GPT-Live voice for meetings and calls; `colleague voices` lists them.
# COLLEAGUE_VOICE=marin

# Phone calls (optional). See docs/phone.md.
# TWILIO_ACCOUNT_SID=replace_with_your_twilio_account_sid
# TWILIO_AUTH_TOKEN=replace_with_your_twilio_auth_token
# TWILIO_FROM_NUMBER=+15005550006
# Show your own verified number as caller ID instead of TWILIO_FROM_NUMBER.
# COLLEAGUE_CALLER_ID=+14155550100
# Name spoken in the AI disclosure for calls to this number, and your phone for transfers.
# COLLEAGUE_OWNER_NAME=Your Name
# COLLEAGUE_OWNER_PHONE=+14155550100
# Public HTTPS origin for Twilio when you run a server; laptops use a Cloudflare quick tunnel.
# COLLEAGUE_PUBLIC_URL=https://calls.example.com
# Answer calls to your Twilio number and send the message to a webhook.
# COLLEAGUE_ACCEPT_INBOUND=1
# COLLEAGUE_NOTIFY_WEBHOOK=https://example.com/hooks/colleague
# Restrict destinations by country calling code, for example 1,44.
# COLLEAGUE_ALLOWED_CALLING_CODES=1
