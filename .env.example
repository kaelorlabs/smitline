OPENAI_API_KEY=replace_with_your_project_api_key

# Easiest: run `smitline setup secrets` and fill in the page instead of editing this file.

# Your name, spoken in the AI disclosure ("calling on behalf of ..."), and your phone
# for rehearsals, the setup test call, and taking over calls.
# SMITLINE_OWNER_NAME=Your Name
# SMITLINE_OWNER_PHONE=+14155550100
# GPT-Live voice for meetings and calls (see `smitline voices`), and extra voice names to allow.
# SMITLINE_VOICE=marin
# SMITLINE_EXTRA_VOICES=
# Meetings open with a short AI disclosure naming SMITLINE_OWNER_NAME unless a call
# brief names someone else. Set to 0 to turn it off.
# SMITLINE_MEETING_INTRO=1
# The meeting camera: still (default) shows one picture per state and costs almost no CPU;
# animated redraws at 30 fps and needs about a full CPU core more.
# SMITLINE_MEETING_CAMERA_STYLE=still
# The model GPT-Live hands hard questions to, and whether it may search the web (1 to allow).
# SMITLINE_PHONE_BACKEND_MODEL=gpt-5.6-terra
# SMITLINE_PHONE_WEB_SEARCH=0
# SMITLINE_MEETING_BACKEND_MODEL=gpt-5.6-terra
# SMITLINE_MEETING_WEB_SEARCH=0

# Phone calls (optional). See docs/phone.md. The numbers below are examples.
# SignalWire's free trial works (calls to up to 10 verified numbers); Twilio needs an upgraded account.
# SIGNALWIRE_SPACE=yourname.signalwire.com
# SIGNALWIRE_PROJECT_ID=replace_with_your_project_id
# SIGNALWIRE_API_TOKEN=replace_with_your_api_token
# SIGNALWIRE_SIGNING_KEY=replace_with_your_signing_key
# SIGNALWIRE_FROM_NUMBER=+14155550124
# TWILIO_ACCOUNT_SID=replace_with_your_twilio_account_sid
# TWILIO_AUTH_TOKEN=replace_with_your_twilio_auth_token
# A number bought in Twilio (needed for incoming calls).
# TWILIO_FROM_NUMBER=+14155550123
# Show your own verified number on outgoing calls instead.
# SMITLINE_CALLER_ID=+14155550100
# How call audio travels: relay (through this computer), sip (OpenAI dials out through a SIP
# trunk; `smitline setup sip-trunk` creates one on SignalWire), or sip-webhook. See docs/phone.md.
# SMITLINE_PHONE_AUDIO=relay
# SMITLINE_SIP_TRUNK_URL=sips:yourname-smitline-openai.dapp.signalwire.com:5061
# SMITLINE_SIP_USERNAME=+14155550124
# SMITLINE_SIP_PASSWORD=replace_with_the_generated_password
# OPENAI_PROJECT_ID=proj_replace_me
# OPENAI_WEBHOOK_SECRET=replace_with_whsec_secret
# Record calls in your Twilio account (the agent says so on the call).
# SMITLINE_RECORD_CALLS=0
# SignalWire only: let its player smooth packet delays and bursts (Stream realtime).
# SMITLINE_STREAM_REALTIME=0
# Public HTTPS origin for Twilio when you run a server; laptops use a Cloudflare quick tunnel.
# SMITLINE_PUBLIC_URL=https://calls.example.com
# Answer calls to your Twilio number and send the message to a webhook.
# SMITLINE_ACCEPT_INBOUND=1
# SMITLINE_MAX_INBOUND=2
# SMITLINE_NOTIFY_WEBHOOK=https://example.com/hooks/smitline
# Allow result webhooks to hosts on your own network.
# SMITLINE_WEBHOOK_ALLOW_PRIVATE=0
# Restrict destinations by country calling code, for example 1,44.
# SMITLINE_ALLOWED_CALLING_CODES=1
# Call people only during these hours, their local time (off turns the check off).
# SMITLINE_CALLING_HOURS=08:00-21:00
# At most this many calls to one number per 24 hours, and calls per hour (0 turns a limit off).
# SMITLINE_MAX_CALLS_PER_NUMBER=5
# SMITLINE_MAX_CALLS_PER_HOUR=20
# Allow premium-rate and satellite numbers, which can cost dollars a minute.
# SMITLINE_ALLOW_PREMIUM_NUMBERS=0
# Write a timing trace of each phone call's audio (audio-trace.jsonl next to the call record), for diagnosing choppy sound.
# SMITLINE_AUDIO_TRACE=0
