# The runtime daemon for computers without a usable Python: start-runtime-daemon.sh
# builds this image and runs it when the host cannot create the daemon's venv.
# The code is mounted at run time, so only dependency changes need a rebuild.
# The Docker CLI starts meeting containers through the host's Docker socket, and
# cloudflared gives laptops their phone tunnel without a second container.
FROM docker:29.8.1-cli AS docker-cli
FROM cloudflare/cloudflared:2026.9.3 AS cloudflared

FROM python:3.12-slim-bookworm
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins
COPY --from=cloudflared /usr/local/bin/cloudflared /usr/local/bin/cloudflared
COPY requirements-daemon.txt /tmp/requirements-daemon.txt
RUN pip install --no-cache-dir -r /tmp/requirements-daemon.txt && rm /tmp/requirements-daemon.txt
ENV PYTHONUNBUFFERED=1 HOME=/tmp
