#!/bin/sh
# `docker exec` runs as root; the CLI writes settings the service must read, so it always runs
# as the same app user the service runs as.
if [ "$(id -u)" = 0 ]; then
  exec setpriv --reuid=app --regid=app --init-groups env HOME=/home/app node /app/packages/cli/src/smitline.mjs "$@"
fi
exec node /app/packages/cli/src/smitline.mjs "$@"
